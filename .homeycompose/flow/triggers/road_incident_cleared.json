{
  "title": {
    "en": "A road incident is cleared",
    "sv": "En trafikhändelse är över"
  },
  "hint": {
    "en": "Runs when a traffic message on the roads this device watches ends, for example when an accident has been cleared. Only during the device's active hours.",
    "sv": "Körs när ett trafikmeddelande på vägarna som enheten bevakar upphör, till exempel när en olycka har röjts undan. Bara under enhetens aktiva timmar."
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=road"
    }
  ],
  "tokens": [
    {
      "name": "text",
      "type": "string",
      "title": {
        "en": "Message",
        "sv": "Meddelande"
      },
      "example": "Cleared: Olycka on E65"
    },
    {
      "name": "type",
      "type": "string",
      "title": {
        "en": "Type",
        "sv": "Typ"
      },
      "example": "Olycka"
    },
    {
      "name": "road",
      "type": "string",
      "title": {
        "en": "Road",
        "sv": "Väg"
      },
      "example": "E65"
    },
    {
      "name": "location",
      "type": "string",
      "title": {
        "en": "Location",
        "sv": "Plats"
      },
      "example": "Uppsala - Stockholm"
    }
  ]
}
