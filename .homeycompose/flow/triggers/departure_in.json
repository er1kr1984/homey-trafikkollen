{
  "title": {
    "en": "A departure leaves in ... minutes",
    "sv": "En avgång går om ... minuter"
  },
  "titleFormatted": {
    "en": "A departure leaves in [[minutes]] minutes",
    "sv": "En avgång går om [[minutes]] minuter"
  },
  "hint": {
    "en": "Runs once per departure when it is this many minutes away (live time). Make several Flows for several warnings, e.g. 10 and 3 minutes. Follows the device's active hours and filters.",
    "sv": "Körs en gång per avgång när den är så här många minuter bort (realtid). Gör flera flöden för flera varningar, t.ex. 10 och 3 minuter. Följer enhetens aktiva tider och filter."
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=departures|ferry"
    },
    {
      "name": "minutes",
      "type": "number",
      "min": 0,
      "max": 120,
      "step": 1,
      "placeholder": {
        "en": "10",
        "sv": "10"
      }
    }
  ],
  "tokens": [
    {
      "name": "text",
      "type": "string",
      "title": {
        "en": "Departure",
        "sv": "Avgång"
      },
      "example": {
        "en": "07:42 bus 5 → Centralen, platform A",
        "sv": "07:42 buss 5 → Centralen, läge A"
      }
    },
    {
      "name": "line",
      "type": "string",
      "title": {
        "en": "Line",
        "sv": "Linje"
      },
      "example": "5"
    },
    {
      "name": "direction",
      "type": "string",
      "title": {
        "en": "Direction",
        "sv": "Riktning"
      },
      "example": "Centralen"
    },
    {
      "name": "time",
      "type": "string",
      "title": {
        "en": "Departs (expected)",
        "sv": "Avgår (väntat)"
      },
      "example": "07:42"
    },
    {
      "name": "scheduled",
      "type": "string",
      "title": {
        "en": "Departs (timetable)",
        "sv": "Avgår (tidtabell)"
      },
      "example": "07:40"
    },
    {
      "name": "minutes",
      "type": "number",
      "title": {
        "en": "Minutes until it leaves",
        "sv": "Minuter tills den går"
      },
      "example": 9
    },
    {
      "name": "delay",
      "type": "number",
      "title": {
        "en": "Delay (min)",
        "sv": "Försening (min)"
      },
      "example": 2
    },
    {
      "name": "platform",
      "type": "string",
      "title": {
        "en": "Platform / track",
        "sv": "Läge / spår"
      },
      "example": "A"
    }
  ]
}
