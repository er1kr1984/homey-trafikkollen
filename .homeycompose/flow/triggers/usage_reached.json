{
  "title": {
    "en": "Trafiklab usage reaches ... %",
    "sv": "Trafiklab-användningen når ... %"
  },
  "titleFormatted": {
    "en": "Trafiklab usage reaches [[percent]] % of the monthly allowance",
    "sv": "Trafiklab-användningen når [[percent]] % av månadsgränsen"
  },
  "hint": {
    "en": "Runs once a month when this app has used this share of your Trafiklab key's monthly allowance (set in the app settings).",
    "sv": "Körs en gång per månad när appen har använt så här stor del av Trafiklab-nyckelns månadsgräns (ställs in i appinställningarna)."
