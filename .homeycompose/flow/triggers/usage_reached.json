  "args": [
    {
      "name": "percent",
      "type": "number",
      "min": 1,
      "max": 100,
      "step": 1,
      "placeholder": {
        "en": "50",
        "sv": "50"
      }
    }
  ],
  "tokens": [
    {
      "name": "percent",
      "type": "number",
      "title": {
        "en": "Used (%)",
        "sv": "Använt (%)"
      },
      "example": 52
    },
    {
      "name": "total",
      "type": "number",
      "title": {
        "en": "Requests this month",
        "sv": "Anrop den här månaden"
      },
      "example": 52000
    },
    {
      "name": "monthly",
      "type": "number",
      "title": {
        "en": "Monthly allowance",
        "sv": "Månadsgräns"
      },
      "example": 100000
    }
  ]
