{
  "title": {
    "en": "A new road incident appears",
    "sv": "En ny trafikhändelse"
  },
  "hint": {
    "en": "Includes a picture from the traffic camera nearest the incident (within 5 km; otherwise the device's own camera). Use it with \"Send image with message\" to get the picture on your phone.",
    "sv": "Innehåller en bild från trafikkameran närmast händelsen (inom 5 km, annars enhetens egen kamera). Använd den med \"Skicka bild med meddelande\" för att få bilden i telefonen."
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=road"
    }
  ],
  "tokens": [
    {
      "name": "text",
      "type": "string",
      "title": {
        "en": "Message",
        "sv": "Meddelande"
      },
      "example": "Olycka on E4 near Uppsala: Two cars, one lane closed"
    },
    {
      "name": "type",
      "type": "string",
      "title": {
        "en": "Type",
        "sv": "Typ"
      },
      "example": "Olycka"
    },
    {
      "name": "road",
      "type": "string",
      "title": {
        "en": "Road",
        "sv": "Väg"
      },
      "example": "E65"
    },
    {
      "name": "location",
      "type": "string",
      "title": {
        "en": "Location",
        "sv": "Plats"
      },
      "example": "Uppsala - Stockholm"
    },
    {
      "name": "message",
      "type": "string",
      "title": {
        "en": "Details",
        "sv": "Detaljer"
      },
      "example": "One lane closed"
    },
    {
      "name": "severity",
      "type": "number",
      "title": {
        "en": "Severity (1-5)",
        "sv": "Allvarlighet (1-5)"
      },
      "example": 3
    },
    {
      "name": "image",
      "type": "image",
      "title": {
        "en": "Camera picture",
        "sv": "Kamerabild"
      }
    },
    {
      "name": "camera",
      "type": "string",
      "title": {
        "en": "Camera",
        "sv": "Kamera"
      },
      "example": "Mora N"
    },
    {
      "name": "camera_km",
      "type": "number",
      "title": {
        "en": "Camera distance (km)",
        "sv": "Kamerans avstånd (km)"
      },
      "example": 0.6
    }
  ]
}
